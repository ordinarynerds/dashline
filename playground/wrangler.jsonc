{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dashline",
  "compatibility_date": "2026-07-25",

  // Pinned so CI needs one secret rather than two. An account ID is a public identifier — it is in
  // every dashboard URL and is worthless without the API token — so it is safe in a public repo,
  // and hardcoding it means a deploy can never resolve to the wrong account.
  "account_id": "0671370cd8bff3540622ff45c3d85e08",

  // Static assets only — there is no Worker script. The playground is a client-side SPA, so
  // Cloudflare serves the built files directly and never boots an isolate.
  //
  // Hosted here rather than on GitHub Pages because ordinarynerds.com is already a Worker on this
  // account: same zone, same dashboard, and the custom domain below provisions its own DNS record
  // and certificate instead of pointing a CNAME at a second provider.
  "assets": {
    "directory": "./dist",
    // TanStack Router owns the routes, so any unknown path must return index.html with a 200
    // rather than a 404. This replaces the `cp dist/index.html dist/404.html` trick that GitHub
    // Pages needed.
    "not_found_handling": "single-page-application"
  },

  "routes": [
    {
      "pattern": "dashline.ordinarynerds.com",
      "custom_domain": true
    }
  ]
}
